# --- SEO (Phase 7) ---------------------------------------------------
# All optional. Every one of these degrades to an honest "not
# connected" / "not emitted" state when unset — see docs/SEO_STRATEGY.md.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# GOOGLE_SEARCH_CONSOLE_SITE_URL=
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_CREDENTIALS_JSON=
# PAGESPEED_API_KEY=

# --- SEO job orchestration (Phase 12) --------------------------------
# Authorizes GET/POST requests to /api/internal/seo/run
# (Authorization: Bearer <value>). Missing → every request is rejected
# (fails closed). Generate with: openssl rand -base64 32
# Do NOT activate a Vercel Cron entry pointing at this route until this
# is set — see docs/SEO_STRATEGY.md §28 for the exact activation steps.
# CRON_SECRET=

# No real SERP/keyword-research vendor is implemented yet — these are
# placeholders for when one is chosen. "NONE" (or unset) → the weekly
# keyword-analysis job honestly reports NOT_CONFIGURED.
# SERP_PROVIDER=NONE
# SERP_API_KEY=

# --- Analytics (Phase 9) ---------------------------------------------
# Optional GA4 OUTBOUND client script — distinct from the GA4_* vars
# above, which are the inbound *reporting* integration. Missing → no
# GA4 script loads at all, and first-party analytics (Admin →
# Analytics) works fully regardless. When set, the script only loads
# after a visitor accepts the optional analytics consent category.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- MagicFlux AI Lead Qualification bridge ---------------------------
# Optional by design: the /project-inquiry form saves the lead to
# Sigma Plus's own CRM regardless — these two only control whether that
# lead is ALSO forwarded to MagicFlux for AI classification. Missing →
# forwarding is silently skipped (SKIPPED, not an error).
#
# MAGICFLUX_WEBHOOK_URL is the specific deployed MagicFlux workflow's
# webhook URL: https://<your-magicflux-host>/api/workflows/<workflowId>/webhook
# — build (or activate) a webhook-triggered workflow in MagicFlux first,
# then copy its exact webhook URL here.
# MAGICFLUX_WEBHOOK_URL=

# MAGICFLUX_WEBHOOK_SECRET is that SAME workflow's own per-workflow
# secret (never a global/shared MagicFlux secret) — retrieve it from
# MagicFlux itself (its dashboard, or GET /api/workflows/[id]/webhook-secret
# as that workflow's owner). Sent as the X-MagicFlux-Webhook-Secret
# header. Never logged, never exposed to the browser.
# MAGICFLUX_WEBHOOK_SECRET=

# --- Database (Phase 4) ---------------------------------------------
# Real PostgreSQL connection string (Supabase or any standard Postgres
# host both work — this uses the standard `postgres://` connection
# string format). REQUIRED in production: if unset, the app throws
# immediately at startup rather than silently falling back to an
# in-memory/embedded database. Leave unset in local development — see
# below.
# DATABASE_URL=postgres://user:password@host:5432/database

# Local development only. When DATABASE_URL is not set and
# NODE_ENV !== "production", the app uses PGlite (a real embedded
# Postgres) instead — genuine SQL persistence, not a mock, file-backed
# under .data/ by default (gitignored). Override the directory here if
# needed; the test suite always uses its own isolated in-memory
# instance regardless of this variable.
# PGLITE_DATA_DIR=.data/pglite-dev

# --- Admin / CRM auth (Phase 5) --------------------------------------
# Signs the admin session cookie (jose/HS256). REQUIRED in production —
# the app throws at startup rather than falling back to a shared key.
# Generate with: openssl rand -base64 32
# In development, if unset, an ephemeral key is generated per process
# start (fine locally — just means a dev-server restart logs you out).
# ADMIN_SESSION_SECRET=

# There is no signup UI by design. Create (or reset the password of) an
# admin account with:
#   npm run admin:create-user -- --email=you@example.com --password=... --name="Your Name" --role=OWNER

# --- SIGMA AI consultant (Phase 6) ------------------------------------
# Optional by design: the public site (services, Project Builder,
# Contact, WhatsApp, CRM) works fully with this unset — the AI
# Consultant page just shows an honest "temporarily unavailable" state
# and points visitors to those other paths instead. Get a key at
# https://console.anthropic.com/.
# ANTHROPIC_API_KEY=

# Server-configured only — never exposed to the client, never
# overridable by a request. Defaults to "claude-sonnet-5" if unset.
# Must be one of the models this deployment explicitly supports (see
# SUPPORTED_AI_MODELS in src/lib/ai/model-config.ts): claude-sonnet-5,
# claude-opus-5, claude-fable-5, claude-haiku-4-5-20251001. An unlisted
# value is treated the same as a missing API key — AI shows its honest
# "unavailable" state rather than failing unpredictably mid-conversation.
# AI_MODEL=claude-sonnet-5
